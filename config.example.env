# Supply secrets through your environment or secret manager; never commit real values.
NODE_ENV=production
PORT=3000
GATE_ISSUER=https://gate.example.test
GATE_SESSION_COOKIE_DOMAIN=example.test
GATE_BROWSER_SESSION_TTL_SECONDS=2592000
GATE_FIRESTORE_PROJECT_ID=your-google-cloud-project
GATE_FIRESTORE_DATABASE_ID=(default)
# Cloud Run uses its service account through Application Default Credentials.
# Local tests only: FIRESTORE_EMULATOR_HOST=127.0.0.1:55435
GATE_GITHUB_CLIENT_ID=replace-me
GATE_GITHUB_CLIENT_SECRET=replace-me
# Immutable numeric GitHub account ID, not login name or email.
GATE_GITHUB_USER_ID=12345
GATE_COOKIE_KEYS=["replace-with-at-least-32-random-characters"]
# Persist one private RSA signing JWK with kid, use=sig, alg=RS256.
GATE_JWKS={"keys":[]}
GATE_BROWSER_APPS=[{"app_id":"action-tools","app_name":"Actions","redirect_uris":["https://actions.example.test/auth-return.html"]}]
GATE_RESOURCES=[{"audience":"https://api.example.test/mcp","client_id":"action-tools-api","client_secret":"replace-with-at-least-32-random-characters","browser_client_id":"action-tools-browser"}]
